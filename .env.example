# SQLite works without Docker. For Compose, set POSTGRES_PASSWORD and AUTH_TOKENS.
DATABASE_URL=sqlite:///./career.db
# Required for API access; replace this example. start-local.ps1 generates a token for you.
AUTH_TOKENS={"replace-with-a-long-random-token":"local-owner"}
# Optional code link shown by the administrator console.
CAREER_SOURCE_REPOSITORY_URL=
# Production admin access requires explicit Supabase user UUIDs.
CAREER_ADMIN_USER_IDS=
# Personal local mode by default. Production/staging always require approved membership.
CAREER_SHARED_SERVICE=0
# Optional public variant requires Supabase; see deploy/public-access.env.example.
CAREER_ACCESS_MODE=invite
CAREER_ALLOWED_USER_IDS=
# Shared upload budgets count stored payloads, not just original file size.
CAREER_USER_UPLOAD_BYTES=20000000
CAREER_USER_UPLOAD_COUNT=50
CAREER_SHARED_UPLOAD_BYTES=100000000
CAREER_SHARED_UPLOAD_COUNT=250
# Choose one provider. Empty allows a local profile, then legacy OpenAI; none forces manual mode.
# Allowed: huggingface, groq, openai, none. See docs/FREE_PROVIDER_SETUP.md.
# For local UI setup, comment out the selected provider's HF_* or GROQ_* settings below.
CAREER_LLM_PROVIDER=
# Your own HF account token with Make calls to Inference Providers permission.
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:fireworks-ai
# Set to 1 only after checking no purchased credits, auto top-up or custom provider keys.
# This is an account-setting acknowledgement, not a remote billing verification.
HF_FREE_ONLY_CONFIRMED=0
# Optional recurring free-tier route; keep the Groq account on Free tier.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FREE_ONLY_CONFIRMED=0
# Provider-neutral settings fall back to existing OPENAI_* settings when omitted.
CAREER_LLM_TIMEOUT_SECONDS=60
CAREER_LLM_MAX_OUTPUT_TOKENS=4096
CAREER_LLM_SMALL_MODEL=
CAREER_LLM_STAGE_POLICIES={}
CAREER_LLM_PRICING_JSON={}
# Stable provider prompt prefixes and opaque per-user routing markers.
# 0 restores the previous request layout; it does not disable provider-side caching.
CAREER_PROMPT_CACHE_ENABLED=1
# Optional random server secret (at least 32 UTF-8 bytes) shared by app instances.
# Omit for a private process-scoped secret; never use a real user ID or API key.
CAREER_PROMPT_CACHE_SECRET=
# Optional paid OpenAI generation/research; no model is silently selected.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PRIVATE_INPUT_DIR=private_input
# Only for the local read-only MCP process; use an existing token from AUTH_TOKENS.
CAREER_MCP_TOKEN=
# Optional shadow evaluation through the official Typesafe systemone API.
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_SHADOW_ENABLED=0
POSTGRES_PASSWORD=
