# Backend deployment: allow only runtime source, migration metadata and synthetic fixtures.
/*
!/app.py
!/pyproject.toml
!/vercel.json
!/backend/
/backend/*
!/backend/career/
!/backend/career/*.py
!/backend/career/assets/
/backend/career/assets/*
!/backend/career/assets/fonts/
/backend/career/assets/fonts/*
!/backend/career/assets/fonts/CareerKR-Regular.ttf
!/backend/career/assets/fonts/CareerKR-Bold.ttf
!/backend/career/assets/fonts/OFL.txt
!/backend/career/assets/fonts/SOURCE.json
!/backend/career/assets/tokenizer/
!/backend/career/assets/tokenizer/o200k_base.tiktoken
!/backend/career/assets/tokenizer/LICENSE.txt
!/alembic.ini
!/migrations/
/migrations/*
!/migrations/env.py
!/migrations/script.py.mako
!/migrations/versions/
!/migrations/versions/*.py
!/evals/
/evals/*
!/evals/historical_cases.jsonl

# Keep these final. Later reinclusion could upload credentials or personal data.
**/.env*
**/*.env
**/*.env.*
**/.local-settings.json
**/.provider-settings.json
**/.provider-settings.json.*.tmp
**/private_input/**
**/work/**
**/*.db*
**/*.sqlite*
**/*.dump
**/*.backup
**/*.key
**/*.pem
**/__pycache__/**
