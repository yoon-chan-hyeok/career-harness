# PUBLIC variant overlay: apply after backend.env.example or vercel-backend.env.example.
# This is not a complete connection configuration and does not create remote services.
# Keep secrets in backend environment settings. Never use NEXT_PUBLIC for privileged keys.
CAREER_ACCESS_MODE=public
CAREER_REGISTRATION_OPEN=1
AUTH_MODE=supabase
AUTH_TOKENS={}
CAREER_SHARED_SERVICE=1
# No invitation list is required. Admin privileges still require explicit verified user UUIDs.
CAREER_ALLOWED_USER_IDS=
CAREER_ADMIN_USER_IDS=
CAREER_SERVICE_NAME=Career Harness
# Must be supplied by the actual operator before production/staging startup.
CAREER_OPERATOR_NAME=
CAREER_SUPPORT_EMAIL=
CAREER_POLICY_VERSION=2026-10-05
# Actual backup policy in days (0..3650). This setting does not implement automatic deletion.
CAREER_BACKUP_RETENTION_DAYS=
# Public Cloudflare Turnstile site key; configure its matching SECRET inside Supabase Auth.
CAREER_CAPTCHA_SITE_KEY=
# Set to 1 ONLY after checking these controls in the Supabase dashboard and testing them.
# These are operator attestations, not remote verification results.
CAREER_CAPTCHA_ENABLED_CONFIRMED=0
CAREER_SMTP_CONFIGURED_CONFIRMED=0
CAREER_EMAIL_CONFIRMATION_CONFIRMED=0
# Server-only account deletion credential. Choose modern secret or legacy service_role.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Defaults assigned on first verified admission; existing members retain operator-set limits.
# These count provider calls, not chat turns. One writing action can use multiple calls.
CAREER_PUBLIC_DAILY_CALLS=10
CAREER_PUBLIC_MONTHLY_CALLS=100
CAREER_PUBLIC_DAILY_TOKENS=50000
CAREER_PUBLIC_MONTHLY_TOKENS=300000
# Cross-worker fixed-minute limits keyed by verified account UUID.
CAREER_PUBLIC_REQUESTS_PER_MINUTE=120
CAREER_PUBLIC_MUTATIONS_PER_MINUTE=20
CAREER_PUBLIC_MAX_APPLICATIONS=100
CAREER_PUBLIC_MAX_EVIDENCE=500
CAREER_PUBLIC_MAX_SOURCES=500
CAREER_PUBLIC_MAX_ARTIFACTS=5000
# Coarse per-process protection; put shared unauthenticated abuse/DDoS limits at the ingress.
CAREER_RATE_LIMIT_PER_MINUTE=1200
# The base template's user/shared upload and AI budget limits remain in force.
# Do not raise global limits until you have measured the actual database/provider allowance.
