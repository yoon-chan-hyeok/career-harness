# Backend Vercel project only. Set real values in its encrypted environment settings.
# These templates do not create projects, change plans, or provide credentials.
CAREER_ENV=production
AUTH_MODE=supabase
AUTH_TOKENS={}
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256
# Personal service: your verified user UUID; also disable public signup in Supabase.
CAREER_ALLOWED_USER_IDS=
# Admin access is a separate explicit allowlist, never all allowed users.
CAREER_ADMIN_USER_IDS=
CAREER_SOURCE_REPOSITORY_URL=
CAREER_ALLOWED_HOSTS=your-backend.vercel.app
CAREER_CORS_ORIGINS=
# Runtime transaction pooler. Use a separate direct/session URL for release migrations.
DATABASE_URL=postgresql+psycopg://postgres.your-project:replace@your-transaction-pooler-host:6543/postgres?sslmode=verify-full
# Paste the downloaded Supabase public DB CA certificate as a real multiline PEM value.
# app.py writes this public trust material to a process-private temporary file.
# Do not supply a private key. Do not put sslrootcert=/run/secrets/... in this runtime URL.
CAREER_DATABASE_CA_PEM=
DATABASE_POOL_MODE=transaction
DATABASE_POOL_SIZE=1
DATABASE_MAX_OVERFLOW=0
CAREER_MAX_REQUEST_BYTES=4000000
CAREER_RATE_LIMIT_PER_MINUTE=120
EXECUTION_TIMEOUT_SECONDS=330
RUN_MIGRATIONS=0
# Select none until the owner's free account/key is configured. No automatic paid fallback.
CAREER_LLM_PROVIDER=none
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:fireworks-ai
HF_FREE_ONLY_CONFIRMED=0
CAREER_LLM_TIMEOUT_SECONDS=60
CAREER_LLM_MAX_OUTPUT_TOKENS=4096
CAREER_REQUIRE_AI=0
JEV_SHADOW_ENABLED=0
