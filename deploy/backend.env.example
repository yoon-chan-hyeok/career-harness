# Copy into the backend host's secret/environment settings; never commit populated values.
CAREER_ENV=production
AUTH_MODE=supabase
AUTH_TOKENS={}
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256
# Optional personal-service allowlist: verified Supabase user UUIDs, comma-separated.
CAREER_ALLOWED_USER_IDS=
CAREER_ALLOWED_HOSTS=api.example.com,127.0.0.1,localhost
# Vercel proxies the API on the same origin; CORS can remain empty.
CAREER_CORS_ORIGINS=
# Use direct connection or session pooler. URL-encode special password characters.
DATABASE_URL=postgresql+psycopg://postgres.your-project:replace@your-session-pooler-host:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase-ca.crt
# Direct/session migration endpoint, with the same SSL configuration. No transaction pooler.
DATABASE_MIGRATION_URL=
DATABASE_POOL_MODE=session
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
CAREER_MAX_REQUEST_BYTES=10485760
CAREER_RATE_LIMIT_PER_MINUTE=120
# Provider credentials are backend-only. Empty values keep manual mode available.
CAREER_LLM_PROVIDER=
# Free HF routed inference, subject to the account's current credit allowance.
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:fireworks-ai
HF_FREE_ONLY_CONFIRMED=0
# Optional Groq Free-tier connection; never upgrade billing implicitly.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FREE_ONLY_CONFIRMED=0
# The confirmed flags record a user's account check; they do not inspect provider billing.
# See docs/FREE_PROVIDER_SETUP.md before enabling either route.
CAREER_LLM_TIMEOUT_SECONDS=60
CAREER_LLM_MAX_OUTPUT_TOKENS=4096
CAREER_LLM_SMALL_MODEL=
CAREER_LLM_STAGE_POLICIES={}
CAREER_LLM_PRICING_JSON={}
# Existing OpenAI settings remain a compatibility fallback when generic settings are omitted.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_SMALL_MODEL=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=16384
# Explicit stage overrides, no model is silently chosen.
OPENAI_STAGE_POLICIES={}
# Supply current account/model rates only if estimating USD cost. Missing prices remain null.
OPENAI_PRICING_JSON={}
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CAREER_REQUIRE_AI=0
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_SHADOW_ENABLED=0
# Migrations run as a separate release command, once per deployment.
RUN_MIGRATIONS=0
PORT=8000
# Set to actual trusted ingress IPs only; do not use '*' on a public listener.
FORWARDED_ALLOW_IPS=127.0.0.1
